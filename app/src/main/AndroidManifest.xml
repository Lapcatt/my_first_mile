<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 조향각·브레이크·기어·크루즈 읽기 (Vehicle SDK, protection: normal) -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- 방향지시등 읽기 (Vehicle SDK, protection: normal) -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <!-- 음성 안내 (TextToSpeech SDK, 모든 TTS API에 필요) -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <!-- 화면 뒤에서도 차량 신호를 받기 위한 포그라운드 서비스 (Android 14+는 타입별 퍼미션 필요) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".DriveCoachApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DriveCoach">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.DriveCoach"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.DriveCoachService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- specialUse 타입은 용도 설명이 필수 (스토어 심사용) -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Real-time voice driving coach that monitors vehicle signals (steering, turn signal, brake, gear) while driving" />
        </service>
    </application>

</manifest>